# Provider used when --provider is omitted: cliproxy or surf.
LLM_PROVIDER=cliproxy

# Provider model alias or full model ID. See README.md for the built-in aliases.
LLM_MODEL=gpt6luna
LLM_REQUEST_TIMEOUT=180

# OpenAI models through CLI Proxy.
CLIPROXY_API_KEY=replace_with_your_cliproxy_key
CLIPROXY_API_BASE=https://cliproxy.sub2api-best.com/v1

# SURF Research Cloud / Willma OpenAI-compatible endpoint.
SURF_API_KEY=replace_with_your_surf_key
SURF_API_BASE=https://willma.surf.nl/api/v0

# Paper discovery. Unpaywall requires a real contact email. A Semantic Scholar key is
# optional but improves rate limits for a large batch.
UNPAYWALL_EMAIL=your_email@example.org
SEMANTIC_SCHOLAR_API_KEY=
